FROM python:3.10-slim

# Install system dependencies (including gcc, g++, and python3-dev to compile C extensions like webrtcvad)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-install CPU-only PyTorch to fit inside Free Tier build RAM and disk limits
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Copy voice requirements and install dependencies
COPY requirements.voice.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the service code
COPY voice_service.py .

EXPOSE 8001

# Start FastAPI server using uvicorn, dynamically binding to the port specified by the platform
CMD ["sh", "-c", "uvicorn voice_service:app --host 0.0.0.0 --port ${PORT:-8001}"]
